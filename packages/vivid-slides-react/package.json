{
    "name": "@vivid/slides-react",
    "version": "0.1.0",
    "description": "Production-grade React components for rendering AI-generated presentations with streaming support",
    "type": "module",
    "main": "./dist/index.cjs",
    "module": "./dist/index.js",
    "types": "./dist/index.d.ts",
    "exports": {
        ".": {
            "import": "./dist/index.js",
            "require": "./dist/index.cjs",
            "types": "./dist/index.d.ts"
        }
    },
    "files": [
        "dist"
    ],
    "scripts": {
        "dev": "vite build --watch",
        "build": "tsc && vite build",
        "lint": "eslint src --ext ts,tsx",
        "typecheck": "tsc --noEmit",
        "prepublishOnly": "npm run build"
    },
    "peerDependencies": {
        "react": "^18.0.0",
        "react-dom": "^18.0.0"
    },
    "dependencies": {
        "@emotion/is-prop-valid": "^1.4.0",
        "clsx": "^2.1.1",
        "framer-motion": "^10.18.0",
        "jspdf": "^3.0.4",
        "lucide-react": "^0.469.0",
        "modern-screenshot": "^4.6.7",
        "pptxgenjs": "^4.0.1",
        "tailwind-merge": "^2.2.0"
    },
    "devDependencies": {
        "@types/react": "^18.2.0",
        "@types/react-dom": "^18.2.0",
        "@vitejs/plugin-react": "^4.2.0",
        "typescript": "^5.3.0",
        "vite": "^5.0.0",
        "vite-plugin-dts": "^3.7.0"
    },
    "keywords": [
        "react",
        "presentation",
        "slides",
        "pptx",
        "pdf",
        "ai",
        "streaming",
        "powerpoint",
        "llm",
        "component-library"
    ],
    "author": "",
    "license": "MIT",
    "repository": {
        "type": "git",
        "url": ""
    },
    "bugs": {
        "url": ""
    },
    "homepage": ""
}